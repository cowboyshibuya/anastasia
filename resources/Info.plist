    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Sparkle auto-update configuration, intentionally absent until Anastasia
         has its own release endpoint and signing key. Sparkle's `startUpdater`
         rejects a host with no SUFeedURL, so `updater::init` returns None and
         the app runs with in-app updates simply switched off (see
         src/updater.rs). Restore SUFeedURL + SUPublicEDKey — and the private
         half in the login keychain — to turn updates back on. -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
