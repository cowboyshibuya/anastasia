{
  // Landing page: pure static assets, no worker script or production domain.
  // Attach a custom domain only after Anastasia owns and configures one.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "anastasia-landing",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "assets": {
    "directory": "public"
  }
}
